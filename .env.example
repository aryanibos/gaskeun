# GasKeun — template konfigurasi environment
# Salin ke .env lalu sesuaikan. .env diabaikan git (pola .env* di .gitignore),
# jadi file template ini perlu di-commit dengan: git add -f .env.example
#
# Aplikasi masih full mock: belum ada kode di src/ yang membaca variabel di sini.
# Jangan menaruh secret di file ini (lihat bagian client di bawah).

# --- Server dev (dibaca vite.config.ts lewat process.env) --------------------
# `pnpm dev` TIDAK memuat file ini ke process.env, jadi nilai di bawah hanya
# berlaku kalau Vite dijalankan lewat Node dengan --env-file:
#   node --env-file=.env node_modules/vite/bin/vite.js
# Variabel yang sudah diset di shell tetap menang atas nilai di file ini.
PORT=8443
FIGMA_DEV_SERVER_HOST=0.0.0.0

# Prefix path saat aplikasi disajikan di sub-path (base = FIGMA_PUBLIC_URL + '/').
# Kosongkan untuk lokal, base jadi '/'.
# FIGMA_PUBLIC_URL=

# --- Variabel client (import.meta.env) ---------------------------------------
# Hanya variabel berprefix VITE_ yang terbaca di browser, dan nilainya ikut
# tertanam di bundle hasil build. Jangan isi dengan API key (Gemini, Meta,
# LinkedIn, TikTok, dsb.); kunci seperti itu harus disimpan di backend.
# Contoh untuk nanti, saat backend sudah ada:
# VITE_API_URL=http://localhost:3000
